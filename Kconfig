# PQCP Zephyr Trust Stack - Kconfig Configuration
#
# Post-Quantum Cryptography Package for Zephyr RTOS
# Implements ML-KEM (FIPS-203) and ML-DSA (FIPS-204)

menuconfig PQCP
	bool "PQ Code Package - Post-Quantum Cryptography"
	help
	  Enable the PQ Code Package post-quantum cryptography module.
	  This provides ML-KEM (FIPS-203) and ML-DSA (FIPS-204) implementations
	  using mlkem-native and mldsa-native libraries.

if PQCP

# =============================================================================
# ML-KEM (FIPS-203) Configuration
# =============================================================================
menu "ML-KEM (FIPS-203) Configuration"

config PQCP_MLKEM
	bool "Enable ML-KEM support"
	default y
	help
	  Enable ML-KEM (Module-Lattice Key Encapsulation Mechanism) support.
	  ML-KEM is standardized in FIPS-203.

if PQCP_MLKEM

config PQCP_MLKEM_LEVEL_512
	bool "ML-KEM-512 (NIST Level 1)"
	default n
	help
	  Enable ML-KEM-512 providing NIST security level 1.
	  Public key: 800 bytes, Ciphertext: 768 bytes.

config PQCP_MLKEM_LEVEL_768
	bool "ML-KEM-768 (NIST Level 3)"
	default y
	help
	  Enable ML-KEM-768 providing NIST security level 3.
	  Public key: 1184 bytes, Ciphertext: 1088 bytes.
	  This is the recommended default for most applications.

config PQCP_MLKEM_LEVEL_1024
	bool "ML-KEM-1024 (NIST Level 5)"
	default n
	help
	  Enable ML-KEM-1024 providing NIST security level 5.
	  Public key: 1568 bytes, Ciphertext: 1568 bytes.

config PQCP_MLKEM_MULTI_LEVEL
	bool "Multi-level ML-KEM build"
	default n
	help
	  Build a single library that supports multiple ML-KEM security levels
	  at runtime. This increases code size but allows runtime level selection.

config PQCP_MLKEM_MONOLITHIC
	bool "Monolithic ML-KEM build (single translation unit)"
	default n
	depends on !SOC_FAMILY_ARM
	help
	  Build ML-KEM as a single translation unit for potential LTO benefits.
	  This is primarily useful for host/native_sim builds and is not
	  recommended for MCU targets due to increased peak memory during
	  compilation.

endif # PQCP_MLKEM
endmenu

# =============================================================================
# ML-DSA (FIPS-204) Configuration
# =============================================================================
menu "ML-DSA (FIPS-204) Configuration"

config PQCP_MLDSA
	bool "Enable ML-DSA support"
	default y
	help
	  Enable ML-DSA (Module-Lattice Digital Signature Algorithm) support.
	  ML-DSA is standardized in FIPS-204.

if PQCP_MLDSA

config PQCP_MLDSA_LEVEL_44
	bool "ML-DSA-44 (NIST Level 2)"
	default n
	help
	  Enable ML-DSA-44 providing NIST security level 2.
	  Public key: 1312 bytes, Signature: 2420 bytes.

config PQCP_MLDSA_LEVEL_65
	bool "ML-DSA-65 (NIST Level 3)"
	default y
	help
	  Enable ML-DSA-65 providing NIST security level 3.
	  Public key: 1952 bytes, Signature: 3293 bytes.
	  This is the recommended default for most applications.

config PQCP_MLDSA_LEVEL_87
	bool "ML-DSA-87 (NIST Level 5)"
	default n
	help
	  Enable ML-DSA-87 providing NIST security level 5.
	  Public key: 2592 bytes, Signature: 4595 bytes.

config PQCP_MLDSA_MULTI_LEVEL
	bool "Multi-level ML-DSA build"
	default n
	help
	  Build a single library that supports multiple ML-DSA security levels
	  at runtime. This increases code size but allows runtime level selection.

config PQCP_MLDSA_STREAMING
	bool "ML-DSA streaming API"
	default y
	help
	  Enable streaming hash-based signing for large messages. This allows
	  signing messages that exceed available RAM by processing in chunks.

config PQCP_MLDSA_MONOLITHIC
	bool "Monolithic ML-DSA build (single translation unit)"
	default n
	depends on !SOC_FAMILY_ARM
	help
	  Build ML-DSA as a single translation unit. Primarily useful for
	  host/native_sim builds.

endif # PQCP_MLDSA
endmenu

# =============================================================================
# RNG Configuration
# =============================================================================
menu "Random Number Generator Configuration"

choice PQCP_RNG_MODE
	prompt "RNG Backend"
	default PQCP_RNG_ZEPHYR_ENTROPY

config PQCP_RNG_ZEPHYR_ENTROPY
	bool "Zephyr Entropy (sys_csrand_get)"
	depends on ENTROPY_GENERATOR
	help
	  Use Zephyr's cryptographically secure random number generator
	  (sys_csrand_get) which is backed by hardware entropy sources.
	  This is the recommended option for production use.

config PQCP_RNG_PSA
	bool "PSA Crypto RNG"
	depends on MBEDTLS_PSA_CRYPTO_C || BUILD_WITH_TFM
	help
	  Use PSA Crypto's psa_generate_random() for random number generation.
	  This option is useful when PSA Crypto is already in use.

config PQCP_RNG_CUSTOM
	bool "Custom RNG (application-provided)"
	help
	  Allow application to register a custom RNG implementation.
	  The application must call pqcp_rng_register() before using
	  any PQCP cryptographic operations.

endchoice

config PQCP_RNG_DETERMINISTIC_TEST
	bool "Deterministic RNG for testing (DANGEROUS)"
	depends on PQCP_RNG_CUSTOM
	help
	  WARNING: This option is for testing and ACVP validation ONLY.
	  DO NOT enable this in production builds.

	  Enables a deterministic DRBG that can be seeded with known values
	  for Known Answer Tests (KAT) and ACVP test vectors.

endmenu

# =============================================================================
# Backend Configuration
# =============================================================================
menu "Implementation Backend Configuration"

choice PQCP_IMPLEMENTATION_PROVIDER
	prompt "Cryptographic provider family"
	default PQCP_IMPLEMENTATION_PQCP

config PQCP_IMPLEMENTATION_PQCP
	bool "PQ Code Package (default)"
	help
	  Use the in-tree PQ Code Package implementations (`mlkem-native` and
	  `mldsa-native`). This is the production-oriented default and the only
	  provider family validated across the full MCU profile and PSA paths.

config PQCP_IMPLEMENTATION_BASELINE
	bool "Baseline native-C reference provider (QEMU only)"
	depends on BOARD_QEMU_X86_64
	depends on ((PQCP_MLKEM_LEVEL_512 && !PQCP_MLKEM_LEVEL_768 && !PQCP_MLKEM_LEVEL_1024) || \
		    (PQCP_MLKEM_LEVEL_768 && !PQCP_MLKEM_LEVEL_512 && !PQCP_MLKEM_LEVEL_1024) || \
		    (PQCP_MLKEM_LEVEL_1024 && !PQCP_MLKEM_LEVEL_512 && !PQCP_MLKEM_LEVEL_768))
	depends on ((PQCP_MLDSA_LEVEL_44 && !PQCP_MLDSA_LEVEL_65 && !PQCP_MLDSA_LEVEL_87) || \
		    (PQCP_MLDSA_LEVEL_65 && !PQCP_MLDSA_LEVEL_44 && !PQCP_MLDSA_LEVEL_87) || \
		    (PQCP_MLDSA_LEVEL_87 && !PQCP_MLDSA_LEVEL_44 && !PQCP_MLDSA_LEVEL_65))
	depends on !PQCP_MLKEM_MULTI_LEVEL && !PQCP_MLDSA_MULTI_LEVEL
	help
	  Use the portable C backend paths from mlkem-native and mldsa-native for
	  host-side cost-of-assurance comparisons on qemu_x86_64. The current
	  baseline provider supports single-level ML-KEM-512 / ML-KEM-768 /
	  ML-KEM-1024 and single-level ML-DSA-44 / ML-DSA-65 / ML-DSA-87 builds
	  behind the same Zephyr-facing APIs as the production PQCP provider family.

	  This option is intentionally limited to QEMU comparison runs. It is not a
	  production provider family, does not participate in PSA-driver validation,
	  and must not be used to justify deterministic RNG or MCU-only shortcuts in
	  production-style benchmarking.

endchoice

choice PQCP_BACKEND
	prompt "Implementation Backend"
	default PQCP_BACKEND_AUTO

config PQCP_BACKEND_AUTO
	bool "Automatic (detect ISA features)"
	depends on PQCP_IMPLEMENTATION_PQCP
	help
	  Automatically select the best available backend based on detected
	  ISA features at compile time. Uses native assembly backends when
	  available (AArch64 NEON, x86-64 AVX2, RISC-V RVV) and falls back
	  to portable C otherwise.

config PQCP_BACKEND_FORCE_C
	bool "Force portable C backend"
	depends on PQCP_IMPLEMENTATION_PQCP
	help
	  Force use of the portable C backend even when native backends
	  are available. This is useful for testing and comparison purposes.

config PQCP_BACKEND_FORCE_NATIVE
	bool "Force native backend (advanced)"
	depends on PQCP_IMPLEMENTATION_PQCP
	help
	  Force use of native assembly backends. This may cause build
	  failures or runtime errors on unsupported architectures.
	  Only use this if you know your target supports the required
	  ISA extensions.

config PQCP_BACKEND_CLEAN
	bool "Native-C/reference backend label"
	depends on PQCP_IMPLEMENTATION_BASELINE
	help
	  Metadata-only backend label used by the QEMU baseline implementation
	  family in cost-of-assurance experiments. The baseline provider uses the
	  portable C backend paths from mlkem-native and mldsa-native, so this
	  option exists mainly to keep benchmark metadata explicit and comparable
	  to the PQCP provider family.

endchoice

config PQCP_FIPS202_EXTERNAL
	bool "Use external FIPS-202 implementation"
	default n
	help
	  Use an external SHA-3/SHAKE implementation instead of the one
	  bundled with mlkem-native and mldsa-native. This allows sharing
	  a single FIPS-202 implementation across the system.

config PQCP_LIBOQS_EXPERIMENTAL
	bool "Enable experimental external-provider inventory"
	default n
	help
	  Enable metadata for optional schemes that are outside the native
	  provider families. This option is inventory and policy plumbing only:
	  it is not a production default, does not change the existing crypto
	  APIs, and does not select an implementation for the native families.

config PQCP_REDUCE_RAM
	bool "Reduced RAM mode"
	default n
	help
	  Enable reduced RAM mode which trades performance for lower
	  memory usage. This is useful on very constrained devices.

endmenu

# =============================================================================
# Provider Contract Reporting
# =============================================================================
menu "Provider Contract Reporting"

config PQCP_PROVIDER_CONTRACT
	bool "Enable provider contract reporting"
	default y
	help
	  Enable firmware-visible provider contract helpers. These helpers report
	  which provider family and backend selector were compiled into the image
	  and validate that native ML-KEM and ML-DSA families are still bound to
	  the PQ Code Package native sources.

	  This option is evidence plumbing only. It does not select an
	  implementation, import external code, or change cryptographic behavior.

endmenu

# =============================================================================
# Firmware Build Manifest
# =============================================================================
menu "Firmware Build Manifest"

config PQCP_BUILD_MANIFEST
	bool "Enable firmware build manifest reporting"
	default y
	help
	  Enable C helpers that report the firmware-visible build manifest:
	  PQCP version, Zephyr version, board, enabled PQC level masks, selected
	  profiles, RNG mode, and provider-contract availability. The emitted
	  PQCP_BUILD_MANIFEST marker is intended for QEMU/device transcripts and
	  release evidence binding.

	  This option does not select cryptographic algorithms and does not change
	  ACVP, benchmark, or public crypto API behavior.

endmenu

# =============================================================================
# Firmware Evidence Session
# =============================================================================
menu "Firmware Evidence Session"

config PQCP_EVIDENCE_SESSION
	bool "Enable firmware evidence session markers"
	default y
	help
	  Enable C helpers that wrap firmware-visible evidence output in a
	  begin/event/end session. The session records which high-level evidence
	  markers were required, which were observed, and whether any marker failed
	  or appeared twice. The emitted PQCP_EVIDENCE_SESSION_* markers make QEMU
	  or device transcripts easier to replay for completeness.

	  This option is evidence plumbing only. It does not select cryptographic
	  algorithms and does not change ACVP, benchmark, or public crypto API
	  behavior.

endmenu

# =============================================================================
# Firmware Evidence Transcript Replay
# =============================================================================
menu "Firmware Evidence Transcript Replay"

config PQCP_EVIDENCE_TRANSCRIPT
	bool "Enable firmware evidence transcript replay verifier"
	depends on PQCP_ASSURANCE_STATUS && PQCP_EVIDENCE_SESSION
	default n
	help
	  Enable a small C replay verifier for the stable firmware evidence
	  transcript grammar. The verifier consumes captured UART/QEMU transcript
	  lines, validates hashes and nonce fields, and cross-checks
	  PQCP_EVIDENCE_SESSION_* summaries against the concrete evidence markers
	  that actually appeared in the transcript.

	  This option is evidence plumbing only. It does not select cryptographic
	  algorithms and does not change ACVP, benchmark, or public crypto API
	  behavior.

endmenu

# =============================================================================
# Firmware Policy Evidence
# =============================================================================
menu "Firmware Policy Evidence"

config PQCP_FIRMWARE_POLICY
	bool "Enable firmware policy/readiness evidence"
	depends on PQCP_BUILD_MANIFEST && PQCP_PROVIDER_CONTRACT
	default y
	help
	  Enable C helpers that evaluate firmware-visible profile, provider,
	  algorithm-level, and RNG constraints and emit a stable
	  PQCP_FIRMWARE_POLICY marker. The marker records whether the local image
	  satisfies its derived firmware policy and, on failure, exposes a blocker
	  bit mask for transcript replay.

	  This option is evidence plumbing only. It does not select cryptographic
	  algorithms and does not change ACVP, benchmark, or public crypto API
	  behavior.

endmenu

# =============================================================================
# Firmware Capability Descriptor
# =============================================================================
menu "Firmware Capability Descriptor"

config PQCP_CAPABILITY_DESCRIPTOR
	bool "Enable firmware capability descriptor"
	depends on PQCP_BUILD_MANIFEST && PQCP_PROVIDER_CONTRACT
	depends on PQCP_FIRMWARE_POLICY
	default y
	help
	  Enable a compact C descriptor that summarizes firmware-visible PQC
	  capability, provider-family policy, profile readiness, and compiled
	  evidence plumbing in a stable PQCP_CAPABILITY_DESCRIPTOR marker. This is
	  intended for QEMU/device transcripts and partner review; it is not a
	  certification claim and it does not select cryptographic providers.

	  This option is evidence plumbing only. It does not change public crypto
	  APIs, ACVP wire formats, or benchmark row ordering.

endmenu

# =============================================================================
# Firmware Scorecard Evidence
# =============================================================================
menu "Firmware Scorecard Evidence"

config PQCP_FIRMWARE_SCORECARD
	bool "Enable firmware evidence scorecard"
	depends on PQCP_ASSURANCE_STATUS && PQCP_BUILD_MANIFEST
	depends on PQCP_PROVIDER_CONTRACT && PQCP_FIRMWARE_POLICY
	depends on PQCP_CAPABILITY_DESCRIPTOR && PQCP_EVIDENCE_SESSION
	default y
	help
	  Enable a compact C appraisal marker that evaluates the current
	  firmware-visible evidence chain before the assurance status is emitted.
	  The marker reports blocking evidence issues, non-blocking warnings,
	  production interpretation state, required session events, artifact count,
	  and a deterministic readiness score.

	  This option is evidence plumbing only. It does not select cryptographic
	  algorithms and does not change ACVP, benchmark, or public crypto API
	  behavior.

endmenu

# =============================================================================
# On-Device Deployment Advisor
# =============================================================================
menu "On-Device PQC Deployment Advisor"

config PQCP_DEPLOYMENT_ADVISOR
	bool "Enable allocation-free PQC deployment advisor"
	default n
	help
	  Enable a deterministic C decision-support engine that evaluates
	  caller-supplied PQC benchmark and evidence facts against a constrained
	  deployment scenario. The advisor preserves rejected candidates with
	  explicit blocker masks, distinguishes hard feasibility from evidence
	  maturity, ranks accepted or conditional candidates, and emits a
	  prioritized missing-experiment plan.

	  The advisor does not select providers, execute cryptographic operations,
	  alter ACVP or benchmark formats, or claim certification. It is intended
	  for device-side policy demonstrations, QEMU experiments, and partner
	  review flows that need the recommendation logic to be replayable in C.

config PQCP_DEPLOYMENT_ROBUSTNESS
	bool "Enable deployment Pareto and sensitivity analysis"
	depends on PQCP_DEPLOYMENT_ADVISOR
	default n
	help
	  Enable allocation-free analysis of deployment recommendation
	  robustness. The analyzer calculates per-budget headroom, binding
	  constraints, Pareto-frontier membership, uniform budget-tightening
	  tolerance, and recommendation stability across ranking preferences.

	  This prevents a high-scoring but fragile or dominated candidate from
	  being presented as a robust deployment recommendation.

config PQCP_DEPLOYMENT_CAMPAIGN
	bool "Enable deployment measurement campaign accumulator"
	depends on PQCP_DEPLOYMENT_ROBUSTNESS
	default n
	help
	  Enable an allocation-free repeated-measurement accumulator for
	  deployment decision inputs. Callers provide observation storage; the
	  module summarizes latency, cycles, footprint, and energy samples using
	  integer min/median/p90/p99/MAD/CV statistics, emits stable campaign
	  markers, and projects conservative candidate facts for the deployment
	  advisor.

	  This is intended for QEMU and board benchmark harnesses that need to
	  preserve variance and quality concerns before producing a recommendation.

config PQCP_DEPLOYMENT_TRANSCRIPT
	bool "Enable deployment transcript replay verifier"
	depends on PQCP_DEPLOYMENT_CAMPAIGN
	default n
	help
	  Enable a compact C replay verifier for PQCP_DEPLOYMENT_* transcript
	  markers. The verifier consumes captured QEMU/UART lines and checks that
	  campaign metrics, projected candidates, advisor decisions, robustness
	  summaries, and gap rows agree on counts and top-candidate identity.

	  This is intended for local replay and partner-review harnesses that need
	  to detect tampered or internally inconsistent deployment evidence.

config PQCP_DEPLOYMENT_APPRAISAL
	bool "Enable deployment evidence appraisal scorecard"
	depends on PQCP_DEPLOYMENT_TRANSCRIPT
	default n
	help
	  Enable a profile-specific deployment evidence appraisal layer. The
	  scorecard consumes a replayed PQCP_DEPLOYMENT_* transcript result and
	  classifies it for lab, paper, product, partner-review, or hardware-review
	  use with explicit blockers, warnings, readiness score, and a stable
	  PQCP_DEPLOYMENT_APPRAISAL marker.

	  This option does not run benchmarks or select algorithms. It turns
	  already-replayed deployment evidence into a reviewer-visible policy
	  decision.

config PQCP_DEPLOYMENT_CLAIMS
	bool "Enable deployment claim support matrix"
	depends on PQCP_DEPLOYMENT_APPRAISAL
	default n
	help
	  Enable a compact C claim-support matrix for deployment evidence. The
	  matrix consumes advisor, robustness, transcript replay, and appraisal
	  results and emits stable PQCP_DEPLOYMENT_CLAIM markers classifying
	  deployment claims as supported, partial, or unsupported.

	  This option does not add crypto algorithms or change benchmark, ACVP, or
	  public crypto API behavior. It makes firmware-visible deployment claims
	  explicit enough for replay and partner review.

config PQCP_DEPLOYMENT_TRACE_BUILDER
	bool "Enable deployment trace builder"
	depends on PQCP_DEPLOYMENT_CLAIMS
	default n
	help
	  Enable an allocation-free trace builder that formats stable
	  PQCP_DEPLOYMENT_* markers into caller-owned memory, feeds the same
	  lines into the deployment replay verifier, and emits a stable digest
	  marker. This lets firmware demos bind advisor, campaign, robustness,
	  decision, and gap evidence without heap allocation.

	  This option does not alter marker field ordering, ACVP behavior,
	  benchmark output, or public cryptographic APIs.

config PQCP_DEPLOYMENT_PIPELINE
	bool "Enable end-to-end deployment evidence pipeline"
	depends on PQCP_DEPLOYMENT_TRACE_BUILDER
	default n
	help
	  Enable a deterministic orchestration layer that runs campaign
	  projection, advisor ranking, robustness analysis, trace replay,
	  profile appraisal, and claim scoring from one firmware API call.

	  The pipeline is evidence plumbing only. It uses caller-supplied
	  scenario/candidate facts and does not execute crypto operations or
	  select runtime providers.

config PQCP_DEPLOYMENT_BUDGET
	bool "Enable deployment budget evidence verdicts"
	depends on PQCP_DEPLOYMENT_PIPELINE
	default n
	help
	  Enable firmware-side budget and evidence verdicts over an executed
	  deployment pipeline. The evaluator converts candidate measurements,
	  scenario budgets, pipeline replay/appraisal/claim status, and required
	  evidence flags into stable PQCP_DEPLOYMENT_BUDGET_* markers.

	  This option is evidence plumbing only. It does not alter public crypto
	  APIs, ACVP behavior, benchmark metric formats, or provider selection.

config PQCP_DEPLOYMENT_EXPERIMENT_PLAN
	bool "Enable deployment next-experiment planning evidence"
	depends on PQCP_DEPLOYMENT_BUDGET
	default n
	help
	  Enable allocation-free firmware-side next-experiment planning over
	  deployment pipeline and budget evidence. The planner emits stable
	  PQCP_DEPLOYMENT_EXPERIMENT* markers that identify missing benchmark,
	  hardware, validation, reproducibility, baseline, policy, transcript,
	  and claim-review work.

	  This option proposes experiments only. It does not execute experiments,
	  select providers, change crypto APIs, alter ACVP wire formats, or alter
	  benchmark marker field ordering.

config PQCP_DEPLOYMENT_REVIEW_PACKET
	bool "Enable deployment review packet digest evidence"
	depends on PQCP_DEPLOYMENT_EXPERIMENT_PLAN
	default n
	help
	  Enable a compact firmware review packet that binds deployment pipeline,
	  budget, and experiment-plan summaries into caller-owned canonical fact
	  lines plus a final PQCP_DEPLOYMENT_REVIEW_PACKET digest marker.

	  This option summarizes existing evidence only. It does not execute
	  experiments, select providers, change crypto APIs, alter ACVP wire
	  formats, or alter benchmark marker field ordering.

config PQCP_DEPLOYMENT_REVIEW_VERIFIER
	bool "Enable deployment review packet replay verifier"
	depends on PQCP_DEPLOYMENT_REVIEW_PACKET
	default n
	help
	  Enable allocation-free replay verification for deployment review
	  packet markers. The verifier parses PQCP_DEPLOYMENT_REVIEW_FACT and
	  PQCP_DEPLOYMENT_REVIEW_PACKET lines, recomputes the packet digest, and
	  rejects duplicate, missing, tampered, or inconsistent review evidence.

config PQCP_DEPLOYMENT_REVIEW_AUDIT
	bool "Enable deployment review replay audit aggregation"
	depends on PQCP_DEPLOYMENT_REVIEW_VERIFIER
	default n
	help
	  Enable allocation-free aggregation over one or more replayed
	  deployment review packets. The audit detects replay failures, packet
	  status drift, top-candidate drift, trace digest drift, packet digest
	  diversity, and low review/claim scores, then emits one stable
	  PQCP_DEPLOYMENT_REVIEW_AUDIT marker.

config PQCP_DEPLOYMENT_RELEASE_GATE
	bool "Enable deployment release gate evidence"
	depends on PQCP_DEPLOYMENT_REVIEW_AUDIT
	default n
	help
	  Enable allocation-free release/deployment gate evaluation over the
	  complete firmware evidence chain. The gate applies an explicit profile
	  policy to pipeline, budget, experiment-plan, review-packet, replay, and
	  audit summaries, then emits one stable PQCP_DEPLOYMENT_RELEASE_GATE
	  marker for local partner review transcripts.

config PQCP_DEPLOYMENT_DEVICE_TOKEN
	bool "Enable deployment device evidence token"
	depends on PQCP_DEPLOYMENT_RELEASE_GATE
	depends on PQCP_CAPABILITY_DESCRIPTOR
	default n
	help
	  Enable allocation-free generation and replay checking of a compact
	  nonce-bound PQCP_DEPLOYMENT_DEVICE_TOKEN marker. The token binds the
	  firmware capability descriptor to the deployment release gate result so
	  a captured QEMU/UART transcript can prove which firmware capabilities,
	  provider policy, release decision, top candidate, and evidence digests
	  were present for one review nonce.

	  This option is evidence plumbing only. It does not select providers,
	  execute cryptographic operations, alter public APIs, change ACVP wire
	  formats, or alter benchmark marker ordering.

config PQCP_DEPLOYMENT_DEVICE_TOKEN_REPLAY
	bool "Enable deployment device-token transcript replay"
	depends on PQCP_DEPLOYMENT_DEVICE_TOKEN
	default n
	help
	  Enable allocation-free replay verification for captured deployment
	  device-token transcripts. The verifier parses capability descriptor,
	  release-gate, device-token, and device-token verification markers,
	  recomputes the token digest, rejects duplicate or missing markers, and
	  detects nonce, capability, gate, digest, and verification drift.

	  This option verifies evidence text only. It does not select providers,
	  execute cryptographic operations, alter public APIs, change ACVP wire
	  formats, or alter benchmark marker ordering.

config PQCP_DEPLOYMENT_DEVICE_TOKEN_AUDIT
	bool "Enable deployment device-token replay audit aggregation"
	depends on PQCP_DEPLOYMENT_DEVICE_TOKEN_REPLAY
	default n
	help
	  Enable allocation-free aggregation over one or more replayed deployment
	  device-token transcripts. The audit detects replay failure, nonce drift,
	  top-candidate drift, token-digest drift, release-gate status drift, token
	  status weakness, gate status weakness, and score-floor weakness, then
	  emits one stable PQCP_DEPLOYMENT_DEVICE_TOKEN_AUDIT marker.

	  This option appraises replayed evidence only. It does not select
	  providers, execute cryptographic operations, alter public APIs, change
	  ACVP wire formats, or alter benchmark marker ordering.

config PQCP_DEPLOYMENT_DEVICE_GATE
	bool "Enable deployment device evidence gate"
	depends on PQCP_DEPLOYMENT_DEVICE_TOKEN_AUDIT
	default n
	help
	  Enable allocation-free device-level appraisal over the complete
	  deployment evidence chain: capability descriptor, release gate, device
	  token, token verification, transcript replay, and replay audit. The gate
	  applies an explicit profile policy and emits one stable
	  PQCP_DEPLOYMENT_DEVICE_GATE marker with exact blockers and consistency
	  flags.

	  This option appraises existing evidence only. It does not select
	  providers, execute cryptographic operations, alter public APIs, change
	  ACVP wire formats, or alter benchmark marker ordering.

config PQCP_DEPLOYMENT_DEVICE_PACKET
	bool "Enable deployment device evidence packet"
	depends on PQCP_DEPLOYMENT_DEVICE_GATE
	default n
	help
	  Enable a compact firmware device packet that serializes capability,
	  release-gate, device-token, replay, replay-audit, and device-gate
	  summaries into caller-owned canonical fact lines plus a final
	  PQCP_DEPLOYMENT_DEVICE_PACKET digest marker.

	  This option binds existing evidence only. It does not select providers,
	  execute cryptographic operations, alter public APIs, change ACVP wire
	  formats, or alter benchmark marker ordering.

config PQCP_DEPLOYMENT_DEVICE_PACKET_REPLAY
	bool "Enable deployment device-packet replay verifier"
	depends on PQCP_DEPLOYMENT_DEVICE_PACKET
	default n
	help
	  Enable allocation-free replay verification for deployment device
	  packets. The verifier parses PQCP_DEPLOYMENT_DEVICE_FACT and
	  PQCP_DEPLOYMENT_DEVICE_PACKET markers, recomputes the packet digest,
	  and rejects duplicate, missing, tampered, or inconsistent final device
	  evidence.

	  This option verifies existing evidence text only. It does not select
	  providers, execute cryptographic operations, alter public APIs, change
	  ACVP wire formats, or alter benchmark marker ordering.

