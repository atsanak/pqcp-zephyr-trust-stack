	select PSA_WANT_ALG_GCM
	default n
	help
	  Enable a bounded application-layer channel that binds ML-KEM key
	  establishment and pinned ML-DSA authentication to exporter material from
	  an already established TLS connection. It derives independent finished
	  and AES-256-GCM traffic keys and enforces frame order, transcript hashes,
	  replay windows, sequence numbers, and fail-closed alerts.

	  This is an experimental channel binding, not a standardized hybrid TLS
	  ciphersuite and not a certification claim.

if PQCP_PROTECTED_CHANNEL

config PQCP_PROTECTED_CHANNEL_MUTUAL_AUTH
	bool "Allow mutual ML-DSA authentication"
	default n
	help
	  Permit deployments to require a pinned ML-DSA identity on both peers.
	  Server-authenticated operation remains the default.

config PQCP_PROTECTED_CHANNEL_MBEDTLS
	bool "Enable direct mbedTLS transport adapter"
	depends on MBEDTLS_SSL_KEYING_MATERIAL_EXPORT
	select MBEDTLS_SSL_PROTO_TLS1_3
	select MBEDTLS_SSL_SESSION_TICKETS
	select MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ENABLED
	select MBEDTLS_CIPHERSUITE_TLS1_3_AES_128_GCM_SHA256
	default n
	help
	  Enable direct mbedTLS client/server contexts and exporter transport.
	  Applications may provide a bounded custom BIO or enable the separate
	  Zephyr TCP adapter. Direct contexts are required because Zephyr TLS
	  sockets do not expose exporter keying material.

config PQCP_PROTECTED_CHANNEL_TCP
	bool "Enable Zephyr TCP adapter for direct mbedTLS transport"
	depends on PQCP_PROTECTED_CHANNEL_MBEDTLS
	depends on NETWORKING && NET_SOCKETS
	default n
	help
	  Enable the Zephyr socket adapter for a direct mbedTLS endpoint. This is
	  optional so deterministic in-process TLS tests do not require a QEMU
	  network backend.

config PQCP_OPERATION_CONFORMANCE_CATALOGS
	bool "Enable exhaustive operational conformance catalogs"
	default n
	help
	  Compile replayable witnesses for every runtime state/command,
	  resource/command, recovery/command, channel state/control,
	  path/control, and fault/control decision. The optional catalogs expose
	  3,072 direct policy cases plus 2,048 composite runtime/channel planning
	  cases with deterministic identifiers, expected results, fingerprints,
	  and cross-audits against the executable policy tables and planners.

	  This option is intended for validation firmware, partner review, and
	  evidence capture. Leave it disabled in production images that do not
	  need the additional read-only catalog data.

config PQCP_OPERATION_SCENARIO_CATALOGS
	bool "Enable stateful operational scenario catalogs"
	default n
	help
	  Compile replayable two-operation scenarios across runtime state,
	  resource, and recovery policy plus protected-channel state, path, and
	  fault policy. The scenario engine propagates successful runtime and
	  channel state transitions into the second operation, preserves the
	  original condition after a denied transition, and records fail-fast
	  terminal errors and aggregate reason masks.

	  The optional catalogs expose 3,072 deterministic scenarios and audit
	  every generated expectation against the executable policy lookup
	  functions. Leave this disabled in production images that do not need
	  stateful validation evidence.

config PQCP_RUNTIME_CHANNEL_GUARD_CATALOGS
	bool "Enable runtime and channel guard catalogs"
	default n
	help
	  Compile exhaustive runtime authorization and continuity policy plus
	  protected-channel key-epoch and stream-lifecycle policy. Composite
	  guard evaluators combine these conditions with the existing runtime
	  and protected-channel lifecycle tables and return one enforceable
	  verdict, next state, delay, reason mask, and error.

	  The four optional 16 by 32 catalogs are intended for validation
	  firmware and policy review. Leave them disabled in production images
	  that provide authorization and continuity policy elsewhere.

config PQCP_OPERATION_TRANSITION_CATALOGS
	bool "Enable composed operational transition traces"
	default n
	help
	  Compile deterministic eight-step runtime and protected-channel traces.
	  Runtime traces compose lifecycle, resource, and recovery policy;
	  channel traces compose lifecycle, path, and fault policy. Replay
	  verifies policy precedence, effective state propagation, permission
	  outcomes, errors, and stable fingerprints over 1,024 traces.

	  This validation-only catalog is disabled by default so normal firmware
	  images do not carry the replay witnesses.

endif # PQCP_PROTECTED_CHANNEL
endmenu

# =============================================================================
# PQC Fleet Trust Fabric
# =============================================================================
menu "PQC Fleet Trust Fabric"

config PQCP_FLEET_TRUST
	bool "Enable device enrollment and fleet credential lifecycle"
	depends on PQCP_PROTECTED_CHANNEL
	default n
	help
	  Enable the allocation-free device enrollment and gateway registrar
	  implementation. Devices authenticate a factory ML-DSA identity, generate
	  operational keys locally, receive signed credentials and policy bundles,
	  rotate or revoke identities, authorize managed firmware updates, and bind
	  the resulting identity to the exporter-bound protected channel.

	  Protocol messages use bounded canonical CBOR and ML-DSA-65 signatures.
	  Firmware installation remains platform-owned. Fleet metadata is committed
	  through a two-slot store so interruption restores either the previous
	  complete state or the new complete state.

config PQCP_FLEET_STORE_ITS
	bool "Enable PSA Internal Trusted Storage fleet backend"
	depends on PQCP_FLEET_TRUST
	default n
	help
	  Store the two fleet metadata slots through PSA Internal Trusted Storage.
	  Enable this only on targets that provide the ITS client API and service.

config PQCP_FLEET_TRANSPARENCY
	bool "Enable witnessed fleet transparency services"
	depends on PQCP_FLEET_TRUST
	default n
	help
	  Enable the host-portable, allocation-free append-only Merkle log,
	  inclusion and consistency proofs, signed monotonic checkpoints,
	  independent witness quorum, and signed checkpoint gossip.

	  The implementation follows the RFC 9162 Merkle tree shape and domain
	  separation. Applications provide hashing, signature, persistence,
	  storage, and workspace callbacks so the same semantic core can be used
	  by Zephyr firmware and hosted coordinators.

config PQCP_FLEET_APPROVAL
	bool "Enable multi-party fleet action authorization"
	depends on PQCP_FLEET_TRANSPARENCY
	default n
	help
	  Enable versioned authority sets, role and weight quorum policies,
	  context-bound approval sessions, deterministic approval certificates,
	  witnessed-checkpoint requirements, and fail-closed replay consumption
	  for high-risk fleet operations.

	  Sessions bind the authority-set generation, policy and revocation
	  epochs, target, artifact digest, nonce, deadline, and transparency
	  checkpoint so stale or cross-context approvals cannot be reused.

endmenu

# =============================================================================
# Zero-Trust Edge Security Plane
# =============================================================================
menu "Zero-Trust Edge Security Plane"

config PQCP_EDGE_SECURITY
	bool "Enable allocation-free edge security runtime"
	depends on PQCP_FLEET_TRUST
	default n
	help
	  Enable the bounded zero-trust edge runtime. The runtime composes service
	  identity, policy admission, durable messaging, confidential object
	  storage, incident response, attestation, policy distribution, workload
	  scheduling, provenance, isolation, SLA monitoring, and transactional
	  configuration without dynamic allocation.

	  Applications provide every storage array during initialization, making
	  maximum memory use explicit and suitable for constrained Zephyr targets.
	  The public API is experimental.

endmenu

# =============================================================================
# Extended Validation Support
# =============================================================================
menu "Extended Validation Support"

config PQCP_FUZZ_TESTS
	bool "Enable extended fuzz/stress-style validation tests"
	default n
	help
	  Enable optional stress-oriented tests for the ACVP command parser
	  and TLS self-test harness. These tests are intended for local runs
	  and extended CI workflows and are disabled in the default smoke CI.

config PQCP_CT_SAMPLE_TRANSCRIPT
	bool "Emit raw constant-time smoke sample transcript markers"
	default n
	help
	  Emit additive PQCP_CT_SAMPLE lines from the constant-time smoke ztest.
	  This is intended for full local release evidence capture only. It does
	  not change cryptographic behavior and does not claim formal constant-time
	  verification.

endmenu

