{
  "type": "object",
  "description": "Stable assurance digest manifest.",
  "required": [
    "schema_version",
    "digest_root",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Digest schema version."
    },
    "digest_root": {
      "type": "string",
      "description": "Lowercase SHA-256 digest of the exact artifact bytes.",
      "minLength": 64,
      "format": "sha256"
    },
    "artifacts": {
      "type": "array",
      "description": "Artifacts included in the digest root.",
      "items": {
        "type": "object",
        "description": "Artifact hash entry used by digests and reference values.",
        "required": [
          "name",
          "path",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Stable evidence artifact identifier from the schema catalog.",
            "minLength": 1,
            "format": "artifact-id"
          },
          "path": {
            "type": "string",
            "description": "Safe path relative to the evidence output root or artifact parent.",
            "minLength": 1,
            "format": "relative-path"
          },
          "sha256": {
            "type": "string",
            "description": "Lowercase SHA-256 digest of the exact artifact bytes.",
            "minLength": 64,
            "format": "sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Artifact byte length."
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "canonicalization": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonicalization method used for digest root."
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atsanak/pqcp-zephyr-trust-stack/schemas/evidence/artifacts/pqc_assurance_digest.schema.json",
  "title": "PQC Assurance Digest"
}
