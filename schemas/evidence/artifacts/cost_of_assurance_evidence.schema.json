{
  "type": "object",
  "description": "Per-metric cost-of-assurance guardrail evidence.",
  "required": [
    "schema_version",
    "comparisons"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Artifact schema version."
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pass",
        "passed",
        "fail",
        "failed",
        "warning",
        "not_applicable",
        "skipped",
        null
      ],
      "description": "Verifier status when present."
    },
    "passed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Boolean pass/fail summary when present."
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Generation timestamp when available."
    },
    "summary": {
      "type": [
        "object",
        "string",
        "null"
      ],
      "description": "Human or machine-readable summary."
    },
    "issues": {
      "type": "array",
      "description": "Validation issues emitted by the tool.",
      "items": {
        "type": "object",
        "description": "Validation issue emitted by a replay or policy verifier.",
        "required": [
          "severity",
          "location",
          "message"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "fatal"
            ],
            "description": "Issue severity."
          },
          "location": {
            "type": "string",
            "description": "Artifact, claim, field, or path where the issue was detected.",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "description": "Human-readable issue message.",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 0
    },
    "comparisons": {
      "type": "array",
      "description": "Cost-of-assurance comparisons.",
      "items": {
        "type": "object",
        "description": "Comparison result.",
        "required": [
          "name",
          "metrics"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Comparison name.",
            "minLength": 1
          },
          "passed": {
            "type": "boolean",
            "description": "Comparison pass/fail."
          },
          "metrics": {
            "type": "array",
            "description": "Metric comparison rows.",
            "items": {
              "type": "object",
              "description": "Metric evidence row.",
              "required": [
                "metric",
                "passed"
              ],
              "properties": {
                "metric": {
                  "type": "string",
                  "description": "Metric name.",
                  "minLength": 1
                },
                "candidate_value": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Candidate measured value."
                },
                "threshold": {
                  "type": "object",
                  "description": "Threshold object."
                },
                "passed": {
                  "type": "boolean",
                  "description": "Metric pass/fail."
                }
              },
              "additionalProperties": true
            },
            "minItems": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cost-of-assurance-evidence.schema.json",
  "title": "Cost Of Assurance Evidence"
}
